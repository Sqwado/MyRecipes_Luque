<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Widget.MyRecipes.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="@dimen/item_card_margin_horizontal"
    android:layout_marginVertical="@dimen/item_card_margin_vertical"
    android:clickable="true"
    android:focusable="true"
    app:cardPreventCornerOverlap="true"
    app:rippleColor="?attr/colorPrimaryContainer">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/image_thumb"
            android:layout_width="match_parent"
            android:layout_height="@dimen/item_image_height"
            android:background="@drawable/bg_placeholder_thumb"
            android:contentDescription="@string/recipe_thumb_description"
            android:scaleType="centerCrop"
            tools:src="@mipmap/ic_launcher" />

        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/item_image_scrim_height"
            android:layout_gravity="bottom"
            android:background="@drawable/bg_image_scrim" />

        <ImageButton
            android:id="@+id/button_remove"
            android:layout_width="@dimen/item_icon_button_size"
            android:layout_height="@dimen/item_icon_button_size"
            android:layout_gravity="top|end"
            android:layout_margin="@dimen/spacing_md"
            android:background="@drawable/bg_icon_chip"
            android:contentDescription="@string/action_remove_favorite"
            android:padding="@dimen/spacing_sm"
            android:src="@drawable/ic_delete"
            app:tint="@color/brand_cream" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/spacing_xxl"
            android:paddingBottom="@dimen/spacing_xxl">

            <TextView
                android:id="@+id/text_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="2"
                android:textAppearance="?attr/textAppearanceTitleMedium"
                android:textColor="@color/brand_cream"
                tools:text="Baked salmon" />

            <TextView
                android:id="@+id/text_saved_at"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xs"
                android:ellipsize="end"
                android:maxLines="1"
                android:textAppearance="?attr/textAppearanceLabelSmall"
                android:textColor="@color/brand_peach"
                tools:text="27 oct. 2026, 14:32" />
        </LinearLayout>
    </FrameLayout>

</com.google.android.material.card.MaterialCardView>

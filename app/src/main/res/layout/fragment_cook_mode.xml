<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    tools:context=".ui.cook.CookModeFragment">

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/progress_cook"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/detail_content_padding_horizontal"
        android:layout_marginTop="@dimen/spacing_lg"
        android:indeterminate="false"
        android:max="100"
        app:indicatorColor="?attr/colorPrimary"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:trackColor="?attr/colorOutlineVariant"
        app:trackCornerRadius="@dimen/spacing_sm"
        app:trackThickness="@dimen/cook_progress_height"
        tools:progress="25" />

    <TextView
        android:id="@+id/text_cook_progress_label"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/detail_content_padding_horizontal"
        android:layout_marginTop="@dimen/spacing_md"
        android:textAppearance="?attr/textAppearanceLabelLarge"
        android:textColor="?attr/colorOnSurfaceVariant"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/progress_cook"
        tools:text="1 / 6" />

    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/pager_cook"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:overScrollMode="never"
        app:layout_constraintBottom_toTopOf="@id/cook_bottom_bar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/text_cook_progress_label" />

    <LinearLayout
        android:id="@+id/cook_bottom_bar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/md_theme_surface_container"
        android:elevation="@dimen/detail_bottom_bar_elevation"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/detail_content_padding_horizontal"
        android:paddingTop="@dimen/detail_bottom_bar_padding"
        android:paddingBottom="@dimen/detail_bottom_bar_padding"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_previous"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="@dimen/detail_bottom_button_min_height"
            android:layout_marginEnd="@dimen/spacing_sm"
            android:layout_weight="1"
            android:enabled="false"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:maxLines="1"
            android:text="@string/action_previous_step"
            app:cornerRadius="@dimen/item_corner_radius" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_next"
            android:layout_width="0dp"
            android:layout_height="@dimen/detail_bottom_button_min_height"
            android:layout_weight="1"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:maxLines="1"
            android:text="@string/action_next_step"
            app:cornerRadius="@dimen/item_corner_radius" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>

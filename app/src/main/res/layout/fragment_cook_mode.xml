<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    tools:context=".ui.cook.CookModeFragment">

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/progress_cook"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/detail_content_padding_horizontal"
        android:layout_marginTop="@dimen/spacing_lg"
        android:indeterminate="false"
        android:max="100"
        app:indicatorColor="?attr/colorPrimary"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:trackColor="?attr/colorOutlineVariant"
        app:trackCornerRadius="@dimen/spacing_sm"
        app:trackThickness="@dimen/cook_progress_height"
        tools:progress="25" />

    <TextView
        android:id="@+id/text_cook_progress_label"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/detail_content_padding_horizontal"
        android:layout_marginTop="@dimen/spacing_md"
        android:textAppearance="?attr/textAppearanceLabelLarge"
        android:textColor="?attr/colorOnSurfaceVariant"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/progress_cook"
        tools:text="1 / 6" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/cook_content_scroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:paddingHorizontal="@dimen/detail_content_padding_horizontal"
        android:paddingTop="@dimen/spacing_xxl"
        android:paddingBottom="@dimen/spacing_xxl"
        app:layout_constraintBottom_toTopOf="@id/cook_bottom_bar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/text_cook_progress_label">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/header_cook_step"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/text_cook_badge"
                    android:layout_width="@dimen/cook_step_badge_size"
                    android:layout_height="@dimen/cook_step_badge_size"
                    android:background="@drawable/bg_step_badge_active"
                    android:gravity="center"
                    android:textAppearance="?attr/textAppearanceHeadlineSmall"
                    android:textColor="?attr/colorOnPrimary"
                    android:visibility="gone"
                    tools:text="1"
                    tools:visibility="visible" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/spacing_xxl"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/text_cook_phase"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textAppearance="?attr/textAppearanceHeadlineSmall"
                        android:textColor="?attr/colorOnSurface"
                        tools:text="Étape 1 sur 5" />

                    <TextView
                        android:id="@+id/text_cook_subtitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_xs"
                        android:textAppearance="?attr/textAppearanceBodyMedium"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        tools:text="Réunis et prépare tout avant de commencer." />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/container_cook_ingredients"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xxl"
                android:orientation="vertical"
                android:visibility="gone"
                tools:visibility="gone" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_cook_step"
                style="@style/Widget.MyRecipes.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xxl"
                android:minHeight="@dimen/cook_step_card_min_height"
                android:visibility="gone"
                tools:visibility="visible">

                <TextView
                    android:id="@+id/text_cook_step"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:lineSpacingMultiplier="1.35"
                    android:padding="@dimen/spacing_xxxl"
                    android:textAppearance="?attr/textAppearanceTitleLarge"
                    android:textColor="?attr/colorOnSurface"
                    tools:text="Put the chicken breasts between two pieces of baking parchment and use a rolling pin to gently bash them until they are approximately 1cm thick." />
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <LinearLayout
        android:id="@+id/cook_bottom_bar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/md_theme_surface_container"
        android:elevation="@dimen/detail_bottom_bar_elevation"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/detail_content_padding_horizontal"
        android:paddingTop="@dimen/detail_bottom_bar_padding"
        android:paddingBottom="@dimen/detail_bottom_bar_padding"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_previous"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="@dimen/detail_bottom_button_min_height"
            android:layout_marginEnd="@dimen/spacing_sm"
            android:layout_weight="1"
            android:enabled="false"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:maxLines="1"
            android:text="@string/action_previous_step"
            app:cornerRadius="@dimen/item_corner_radius" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_next"
            android:layout_width="0dp"
            android:layout_height="@dimen/detail_bottom_button_min_height"
            android:layout_weight="1"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:maxLines="1"
            android:text="@string/action_next_step"
            app:cornerRadius="@dimen/item_corner_radius" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>

<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Widget.MyRecipes.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="@dimen/item_card_margin_horizontal"
    android:layout_marginVertical="@dimen/item_card_margin_vertical"
    android:clickable="true"
    android:focusable="true"
    app:cardPreventCornerOverlap="true"
    app:rippleColor="?attr/colorPrimaryContainer">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/image_thumb"
            android:layout_width="match_parent"
            android:layout_height="@dimen/item_image_height"
            android:background="@drawable/bg_placeholder_thumb"
            android:contentDescription="@string/recipe_thumb_description"
            android:scaleType="centerCrop"
            tools:src="@mipmap/ic_launcher" />

        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/item_image_scrim_height"
            android:layout_gravity="bottom"
            android:background="@drawable/bg_image_scrim" />

        <TextView
            android:id="@+id/text_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:ellipsize="end"
            android:maxLines="2"
            android:paddingHorizontal="@dimen/spacing_xxl"
            android:paddingBottom="@dimen/spacing_xxl"
            android:textAppearance="?attr/textAppearanceTitleMedium"
            android:textColor="@color/brand_cream"
            tools:text="Baked salmon with fennel" />
    </FrameLayout>

</com.google.android.material.card.MaterialCardView>

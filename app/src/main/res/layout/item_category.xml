<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Widget.MyRecipes.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="@dimen/item_card_margin_horizontal"
    android:layout_marginVertical="@dimen/item_card_margin_vertical"
    android:clickable="true"
    android:focusable="true"
    app:rippleColor="?attr/colorPrimaryContainer">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="@dimen/item_card_padding">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/image_thumb"
            android:layout_width="@dimen/item_thumb_size"
            android:layout_height="@dimen/item_thumb_size"
            android:background="@drawable/bg_placeholder_thumb"
            android:contentDescription="@string/category_thumb_description"
            android:scaleType="centerCrop"
            app:shapeAppearanceOverlay="@style/ShapeAppearance.MyRecipes.Thumb"
            app:strokeColor="?attr/colorOutlineVariant"
            app:strokeWidth="1dp"
            tools:src="@mipmap/ic_launcher" />

        <TextView
            android:id="@+id/text_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/item_content_margin_start"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:maxLines="2"
            android:textAppearance="?attr/textAppearanceTitleMedium"
            android:textColor="?attr/colorOnSurface"
            tools:text="Seafood" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
